---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Fact {
  label: string;
  value: string;
}

interface Props {
  index: string;
  label: string;
  meta: string;
  statementA: string;
  statementB: string;
  body: string;
  listTitle: string;
  items: string[];
  facts: Fact[];
  photo: {
    src: ImageMetadata;
    alt: string;
    caption: string;
  };
}

const { index, label, meta, statementA, statementB, body, listTitle, items, facts, photo } =
  Astro.props;
---

<section class="profile section" id="perfil">
  <div class="frame">
    <header class="section__head" data-reveal>
      <span class="mono section__index">({index})</span>
      <span class="mono">{label}</span>
      <span class="mono profile__meta">{meta}</span>
    </header>

    <div class="profile__grid">
      <div class="profile__main">
        <h2 class="profile__statement serif" data-reveal>
          {statementA}
          <br />
          <span class="italic profile__statement-accent">{statementB}</span>
        </h2>

        <p class="profile__body" data-reveal style="--reveal-delay:80ms">{body}</p>

        <div class="profile__list" data-reveal style="--reveal-delay:140ms">
          <p class="mono profile__list-title">{listTitle}</p>
          <ul>
            {
              items.map((item, i) => (
                <li class="profile__item">
                  <span class="mono profile__item-index">{String(i + 1).padStart(2, '0')}</span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <aside class="profile__spec" data-reveal style="--reveal-delay:120ms">
        <figure class="profile__portrait">
          <div class="profile__portrait-frame">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[360, 560, 760]}
              sizes="(min-width: 900px) 360px, 100vw"
              loading="lazy"
              decoding="async"
            />
            <span class="profile__portrait-marks" aria-hidden="true">
              <i></i><i></i><i></i><i></i>
            </span>
            <span class="mono profile__portrait-vlabel" aria-hidden="true">Joaquín Pereira</span>
          </div>
          <figcaption class="mono profile__portrait-cap">
            <span>{photo.caption}</span>
            <span>SPEC / 01</span>
          </figcaption>
        </figure>

        <dl class="profile__facts">
          {
            facts.map((fact) => (
              <div class="profile__fact">
                <dt class="mono">{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>
  </div>
</section>

<style>
  .profile__meta {
    display: none;
    color: var(--gray-2);
  }

  .profile__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .profile__statement {
    font-size: clamp(2.1rem, 5.4vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    font-weight: 400;
  }

  .profile__statement-accent {
    color: var(--bone-3);
  }

  .profile__body {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 56ch;
    color: var(--gray);
    font-size: clamp(0.95rem, 1.3vw, 1.1rem);
    line-height: 1.7;
  }

  .profile__list {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .profile__list-title {
    color: var(--gray-2);
    margin-bottom: 0.9rem;
  }

  .profile__item {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding: 0.72rem 0;
    border-top: 1px solid var(--line-2);
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    letter-spacing: -0.01em;
  }

  .profile__list ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .profile__item:last-child {
    border-bottom: 1px solid var(--line-2);
  }

  .profile__item-index {
    color: var(--steel);
  }

  .profile__spec {
    align-self: start;
    border: 1px solid var(--line);
    background:
      linear-gradient(var(--line-2) 1px, transparent 1px) 0 0 / 100% 34px,
      rgba(138, 148, 163, 0.1);
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .profile__portrait {
    margin: 0 0 clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .profile__portrait-frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--navy-850);
  }

  .profile__portrait-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .profile__portrait:hover .profile__portrait-frame :global(img) {
    transform: scale(1.03);
  }

  .profile__portrait-cap {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
    color: var(--gray-2);
  }

  .profile__portrait-marks,
  .profile__portrait-vlabel {
    display: none;
  }

  .profile__facts {
    margin: 0;
  }

  .profile__fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line-2);
  }

  .profile__fact:last-child {
    border-bottom: 0;
  }

  .profile__fact dt {
    color: var(--gray-2);
    flex-shrink: 0;
  }

  .profile__fact dd {
    margin: 0;
    text-align: right;
    font-size: 0.92rem;
    color: var(--bone-2);
  }

  @media (max-width: 899px) {
    .profile__spec {
      padding: clamp(1rem, 4vw, 1.35rem);
    }

    .profile__portrait-frame {
      aspect-ratio: 4 / 5;
    }

    .profile__portrait-frame :global(img) {
      transition: none;
    }

    .profile__portrait-marks {
      display: block;
      position: absolute;
      inset: 0.95rem;
      pointer-events: none;
    }

    .profile__portrait-marks i {
      position: absolute;
      width: 16px;
      height: 16px;
      border: 0 solid rgba(239, 234, 224, 0.62);
    }

    .profile__portrait-marks i:nth-child(1) {
      top: 0;
      left: 0;
      border-top-width: 1px;
      border-left-width: 1px;
    }

    .profile__portrait-marks i:nth-child(2) {
      top: 0;
      right: 0;
      border-top-width: 1px;
      border-right-width: 1px;
    }

    .profile__portrait-marks i:nth-child(3) {
      bottom: 0;
      left: 0;
      border-bottom-width: 1px;
      border-left-width: 1px;
    }

    .profile__portrait-marks i:nth-child(4) {
      bottom: 0;
      right: 0;
      border-bottom-width: 1px;
      border-right-width: 1px;
    }

    .profile__portrait-vlabel {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      writing-mode: vertical-rl;
      padding: 1.2rem 0.55rem;
      color: var(--bone);
      background: linear-gradient(180deg, rgba(7, 17, 29, 0.74), rgba(7, 17, 29, 0.26));
      -webkit-backdrop-filter: blur(3px);
      backdrop-filter: blur(3px);
      border-right: 1px solid var(--line);
    }

    .profile__facts {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
    }

    .profile__fact {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding: 0.9rem 1rem;
      border: 0;
      background: var(--navy-900);
    }

    .profile__fact dd {
      text-align: left;
    }
  }

  @media (min-width: 900px) {
    .profile__meta {
      display: block;
    }

    .profile__grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }
</style>
